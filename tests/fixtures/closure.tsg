# クロージャ（Phase 2）

# 無名関数を変数に代入
let double = fn(x)
    return x * 2
end
print(double(7))

# 1行ラムダ
let triple = fn(x) x * 3 end
print(triple(4))

# クロージャ: 外側の変数をキャプチャ
fn make_adder(n)
    return fn(x) return x + n end
end

let add5 = make_adder(5)
let add10 = make_adder(10)
print(add5(3))
print(add10(3))

# 高階関数に無名関数を渡す
fn apply(func, val)
    return func(val)
end
print(apply(fn(x) x * x end, 6))

# ネストしたクロージャ
fn make_multiplier(factor)
    return fn(x)
        return x * factor
    end
end
let times3 = make_multiplier(3)
print(times3(7))

# type() で確認
print(type(double))
