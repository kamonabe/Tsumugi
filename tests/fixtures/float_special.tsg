# 浮動小数点の特殊値テスト
#
# 挙動（ツリーウォーク・VM共通、IEEE 754準拠）:
# - 1.0 / 0.0 → inf（Rust の f64 挙動に準拠）
# - 0.0 / 0.0 → NaN
# - inf == inf → true
# - NaN == NaN → false（IEEE 754仕様）

# 正常な浮動小数点演算
print(1.5 + 2.5)
print(10.0 / 3.0)
print(2.0 * 3.5)

# inf の生成
let inf = 1.0 / 0.0
print(inf)

# NaN の生成
let nan = 0.0 / 0.0
print(nan)

# inf との算術
print(inf + 1.0)
print(inf * 2.0)

# Float 比較（IEEE 754準拠）
print(1.5 == 1.5)
print(1.5 != 2.0)
print(1.0 < 2.0)
print(2.0 > 1.0)
print(1.0 <= 1.0)
print(2.0 >= 1.0)

# inf の比較
print(inf == inf)
print(inf > 1000000.0)

# NaN の比較（IEEE 754: NaN は何と比較しても false）
print(nan == nan)
print(nan != nan)

print("完了")
