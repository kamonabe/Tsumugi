# import 失敗後の復旧テスト（tree-walk 版のみ）
# VM 版は import がコンパイル時処理のため try/catch で捕捉できない
#
# 失敗した import を try/catch で捕捉した後、別の正常な import が動くことを確認

# まず失敗する import を試みる
try
    import "import_bad_syntax.tsg"
catch e
    print("caught: " + e["type"])
end

# 失敗後も正常な import ができる（base_dir が壊れていないことの確認）
import "import_lib.tsg"
print(add(3, 4))

print("recovery ok")
