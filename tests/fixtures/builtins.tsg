# pop
let xs = [10, 20, 30]
let v = pop(xs)
print(v)
print(xs)

# slice
print(slice([1, 2, 3, 4, 5], 1, 4))
print(slice("hello", 1, 4))

# contains
print(contains([1, 2, 3], 2))
print(contains([1, 2, 3], 9))
print(contains("hello world", "world"))
print(contains({"name": "tsumugi"}, "name"))

# split / join
let parts = split("one::two::three", "::")
print(parts)
let joined = join(parts, ", ")
print(joined)

# to_int / to_str
print(to_int("100"))
print(to_int(3.14))
print(to_str(42))
print(to_str(true))

# range
print(range(0, 5))
for i in range(1, 4)
    print(i)
end
