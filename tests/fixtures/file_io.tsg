# テスト専用ディレクトリを使う（tree/VM・実行ごとに別パスなので競合しない）
let dir = env("TSG_TEST_DIR")
let target = path_join(dir, "file_io.txt")

# ファイル書き込み
let ok = write_file(target, "line1\nline2\nline3")
print(ok)

# ファイル読み込み
let content = read_file(target)
print(contains(content, "line2"))

# 行ごとに読み込み
let lines = read_lines(target)
print(len(lines))

# 追記
append_file(target, "\nline4")
let updated = read_lines(target)
print(len(updated))

# C10: capability 経路では存在しない file の read は catch 可能な host error になる
# （ambient 時代の null 返しは廃止）。missing-read は canonical_error_inventory / 専用テストで覆う。
