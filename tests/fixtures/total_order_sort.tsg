# 全順序ソート（REV-017、semantic-decisions §17.8）
#
# revision 0.21 で sort() は全値型を覆う単一の全順序 TotalOrder で並ぶ。
# tree-walk / VM 両 backend で順序が一致することを golden fixture で固定する
# （numeric_strict_comparison と同じパターン）。

# --- 数値順（NumericOrder、§17.8.3） ---
print(sort([3, 10, 2]))           # [2, 3, 10]
print(sort([2, 1.5, 10]))         # [1.5, 2, 10]（Int/Float 混在）
print(sort([100, 20, 3, 1]))      # [1, 3, 20, 100]
print(sort([-1, -10, 2]))         # [-10, -1, 2]（負数）

# 2^53 近傍（丸めなしの厳密順序）
print(sort([9007199254740993, 9007199254740992.0]))  # [9007199254740992, 9007199254740993]

# ±Infinity と NaN は数値帯の末尾（-Inf < 有限 < +Inf < NaN）
let inf = 1.0 / 0.0
let nan = 0.0 / 0.0
let ninf = 0.0 - inf
print(sort([inf, 1, ninf, nan, 0]))  # [-Infinity 相当 → ... → NaN]

# --- Str: コードポイント順 ---
print(sort(["banana", "apple", "Cherry", "apple"]))

# --- 型帯順（Null < Bool < 数値 < Str < List < Dict、§17.8.3） ---
print(sort([{"k": 1}, [1], "s", 3, true, null]))

# --- List 再帰（辞書式、prefix は短い方が小） ---
print(sort([[2], [1, 2], [1], []]))         # [[], [1], [1, 2], [2]]
print(sort([[1, [2]], [1, [1]], [1]]))      # [[1], [1, [1]], [1, [2]]]

# --- Dict（key ソート済み (key,value) 列の辞書式、空が最小、value 再帰） ---
print(sort([{"b": 1}, {"a": 2}, {}]))              # [{}, {"a": 2}, {"b": 1}]
print(sort([{"a": 2}, {"a": 1}]))                  # [{"a": 1}, {"a": 2}]（value 再帰）
print(sort([{"a": 1, "b": 1}, {"a": 1}]))          # prefix: entry 少ない方が小

# --- 安定性（同順位要素は元順序を保つ）: Fn は帯内 Equal ---
let f1 = fn() 1 end
let f2 = fn() 2 end
let fns = sort([f1, f2])
print(fns[0] == f1)   # true（安定: 元順序 f1, f2）
print(fns[1] == f2)   # true
