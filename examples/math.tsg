# 数学ユーティリティモジュール

fn square(x)
    return x * x
end

fn cube(x)
    return x * x * x
end

fn power(base, exp)
    let result = 1
    let i = 0
    while i < exp
        result = result * base
        i = i + 1
    end
    return result
end

fn factorial(n)
    if n <= 1
        return 1
    end
    return n * factorial(n - 1)
end
